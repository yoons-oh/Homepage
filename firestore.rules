rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yoonseukoh@gmail.com';
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if settingId == 'career';
      allow create, update, delete: if isAdmin();
    }

    match /tester_applications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
          'appKey',
          'name',
          'email',
          'device',
          'memo',
          'canTest14Days',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.appKey == 'mathmagic'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 120
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 500
        && request.resource.data.canTest14Days == true
        && request.resource.data.status == 'requested';
      allow read, update, delete: if isAdmin();
    }

    match /visit_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
        'path',
        'visitedAt',
        'visitorId',
        'deviceType',
        'referrer'
      ]);
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
